{
	"name": "@jalalix/typescript",
	"version": "0.9.0",
	"private": false,
	"main": "index.js",
	"module": "index.js",
	"types": "index.d.ts",
	"description": "Jalali (Persian/Shamsi) calendar for JavaScript and TypeScript. Extends Date, no dependencies.",
	"author": "Hossein Maklavani <hos.mohamadi@gmail.com> (https://maklavani.dev)",
	"contributors": [
		{
			"name": "Hossein Maklavani",
			"email": "hos.mohamadi@gmail.com",
			"url": "https://maklavani.dev"
		}
	],
	"license": "MIT",
	"keywords": [
		"jalalix",
		"jalali",
		"jalaali",
		"shamsi",
		"persian",
		"farsi",
		"khorshidi",
		"calendar",
		"date",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jalalix/typescript.git"
	},
	"funding": [
		{
			"type": "open_collective",
			"url": "https://opencollective.com/jalalix"
		}
	],
	"bugs": {
		"url": "https://github.com/jalalix/typescript/issues"
	},
	"homepage": "https://jalalix.com",
	"scripts": {
		"dev": "nodemon --exec \"node --experimental-strip-types\" src/index.ts",
		"build": "npm run remove && tsc -p tsconfig.json",
		"remove": "node scripts/remove.mjs",
		"prepublishOnly": "npm run build"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"nodemon": "^3.1.14",
		"rimraf": "^6.1.4",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=18"
	},
	"exports": {
		".": {
			"types": "./index.d.ts",
			"require": "./index.js",
			"import": "./index.js",
			"default": "./index.js"
		}
	},
	"sideEffects": false,
	"files": [
		"index.d.ts",
		"index.js",
		"index.types.d.ts",
		"index.types.js",
		"LICENSE",
		"README.md",
		"CHANGELOG.md"
	]
}
